{
  "formatVersion": 1,
  "name": "Server (HOST-RESOURCES-MIB)",
  "author": "SnmpLens",
  "description": "Processor load and storage of a server or workstation, discovered when you bind it — the indexes differ from one machine to the next, which is exactly what a walk answers and a hand-written list cannot. Processor load is watched above 90% held for ten minutes, which is long enough that a build or a backup does not raise anything.",
  "intervalSec": 60,
  "widgets": [
    {
      "kind": "value",
      "title": "Uptime",
      "oids": [
        "1.3.6.1.2.1.25.1.1.0"
      ],
      "layout": {
        "x": 0,
        "y": 0,
        "w": 4
      }
    },
    {
      "kind": "value",
      "title": "Processes",
      "oids": [
        "1.3.6.1.2.1.25.1.6.0"
      ],
      "layout": {
        "x": 4,
        "y": 0,
        "w": 4
      }
    },
    {
      "kind": "value",
      "title": "Users",
      "oids": [
        "1.3.6.1.2.1.25.1.5.0"
      ],
      "layout": {
        "x": 8,
        "y": 0,
        "w": 4
      }
    },
    {
      "kind": "chart",
      "title": "Processor load",
      "oids": [
        "1.3.6.1.2.1.25.3.3.1.2.{#}"
      ],
      "unit": "%",
      "discover": {
        "walk": "1.3.6.1.2.1.25.3.3.1.2"
      },
      "layout": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 2
      },
      "threshold": {
        "max": 90,
        "forSeconds": 600
      }
    },
    {
      "kind": "chart",
      "title": "Storage used",
      "oids": [
        "1.3.6.1.2.1.25.2.3.1.6.{#}"
      ],
      "discover": {
        "walk": "1.3.6.1.2.1.25.2.3.1.3"
      },
      "layout": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 2
      }
    }
  ]
}
