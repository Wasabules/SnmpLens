{
  "formatVersion": 1,
  "name": "Interfaces (IF-MIB)",
  "author": "SnmpLens",
  "description": "Every interface the equipment reports, discovered when you bind it: their operational state as one wall, and the traffic of the first few as curves. IF-MIB only, so it answers on any agent that serves MIB-2.",
  "intervalSec": 60,
  "widgets": [
    {
      "kind": "value",
      "title": "Uptime",
      "oids": [
        "1.3.6.1.2.1.1.3.0"
      ],
      "layout": {
        "x": 0,
        "y": 0,
        "w": 3
      }
    },
    {
      "kind": "value",
      "title": "Interfaces",
      "oids": [
        "1.3.6.1.2.1.2.1.0"
      ],
      "layout": {
        "x": 0,
        "y": 1,
        "w": 3
      }
    },
    {
      "kind": "grid",
      "title": "Operational state",
      "oids": [
        "1.3.6.1.2.1.2.2.1.8.{#}"
      ],
      "labels": {
        "1": "up",
        "2": "down",
        "3": "testing",
        "4": "unknown",
        "5": "dormant",
        "6": "absent",
        "7": "lower layer down"
      },
      "discover": {
        "walk": "1.3.6.1.2.1.2.2.1.2"
      },
      "layout": {
        "x": 3,
        "y": 0,
        "w": 9,
        "h": 2
      }
    },
    {
      "kind": "chart",
      "title": "Traffic",
      "oids": [
        "1.3.6.1.2.1.2.2.1.10.{#}",
        "1.3.6.1.2.1.2.2.1.16.{#}"
      ],
      "discover": {
        "walk": "1.3.6.1.2.1.2.2.1.2"
      },
      "layout": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 2
      }
    },
    {
      "kind": "chart",
      "title": "Errors",
      "oids": [
        "1.3.6.1.2.1.2.2.1.14.{#}",
        "1.3.6.1.2.1.2.2.1.20.{#}"
      ],
      "discover": {
        "walk": "1.3.6.1.2.1.2.2.1.2"
      },
      "layout": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 2
      }
    }
  ]
}
